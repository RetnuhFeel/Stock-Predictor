# Copy to .env (git-ignored) or set in your host's environment. Never commit real keys.
CORS_ORIGINS=http://localhost:3000
DATA_PROVIDER=yfinance
# TWELVEDATA_API_KEY=
# UPSTREAM_TIMEOUT_S=10
# UPSTREAM_RETRIES=2
# STALE_MAX_AGE_S=86400
# NEWS_TTL_S=600
# LOG_FORMAT=json            # or text
# LOG_LEVEL=INFO
# ADMIN_TOKEN=               # set a long random value to enable GET /api/_stats (unset = 404)
# CLIENT_ERROR_LOGGING=false # true enables POST /api/_client-error
# CLIENT_ERROR_RATE_PER_MIN=10
# LOG_TASK_TOKEN=            # enables POST /api/_tasks/run-prediction-log (unset = 404); same value as the GitHub secret
# DATABASE_URL=              # Postgres URL for a durable prediction log; unset = SQLite in the temp dir (ephemeral on Render free)
# PREDICTION_LOG_TTL_S=120
# MODELS_TTL_S=3600
# HEAVY_RATE_PER_MIN=20
# SENTRY_DSN=                # optional; requires `pip install sentry-sdk`
