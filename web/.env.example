# Base URL of the FastAPI backend (no trailing slash). Must be listed in the backend's CORS_ORIGINS
# for the origin the web app is served from.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Build-time opt-in: send sanitised error reports to the API (also needs CLIENT_ERROR_LOGGING=true there).
# NEXT_PUBLIC_ERROR_REPORTING=false
# Optional: https URL for a "Support this project" footer link (build time). Leave unset to show nothing.
# NEXT_PUBLIC_SUPPORT_URL=
